# Application URL (injected by runtime)
APP_URL="http://localhost:3000"

# Server Configuration
PORT=3000
NODE_ENV="development"

# SQLite Database Path
DATABASE_PATH="./resqgrid.db"

# Authentication (Set strong values in production; never commit real secrets)
JWT_SECRET="change-me-in-production-resqgrid-local-dev-key"
ALLOW_DEMO_LOGIN="true"

# Seed Admin Account (configured via environment variables)
SEED_ADMIN_EMAIL="admin@resqgrid.local"
SEED_ADMIN_PASSWORD="change-me-dev-admin"
SEED_VIEWER_EMAIL="viewer@resqgrid.local"
SEED_VIEWER_PASSWORD="change-me-dev-viewer"
